# ═════════════════════════════════════════════════════════════════════════════
# INTERACTIVE SINE framework – environment configuration
#
# Renamed from template.env. Every variable is prefixed with the app prefix
# (INTERACTIVE_SINE_ here). Keep the prefix in sync across:
#   - app_interactive_sine.py          → ENV_PREFIX in the EDIT block
#   - main_interactive_sine.py         → ENV_PREFIX
#   - endpointType_interactive_sine.py → ENV_PREFIX
# ═════════════════════════════════════════════════════════════════════════════

# ── Layout / frame ───────────────────────────────────────────────────────────

# Width of the left side window (drawer) in pixels.
INTERACTIVE_SINE_SIDEBAR_WIDTH=600

# Vertical offset of the fixed tool bar, in pixels:
#   64  → standalone (only the app header above the bar)
#   114 → embedded in the landing page (landing header + app header above)
# The launcher sets this automatically; override only if needed.
INTERACTIVE_SINE_TOOLBAR_TOP=64

# 1 when rendered embedded in the landing page (banner suppressed).
# Set automatically by app_interactive_sine.py; do not set manually.
# INTERACTIVE_SINE_EMBEDDED=0

# ── Server ────────────────────────────────────────────────────────────────────

# Standalone port used by `python app_interactive_sine.py`.
INTERACTIVE_SINE_PORT=8083

# local  → load interactive_sine.env / interactive_sine.secrets.env from disk
# compose→ trust the Docker Compose environment (no .env files loaded)
INTERACTIVE_SINE_CONFIG_SOURCE=local

# NiceGUI browser-storage secret (set a real random value in production).
INTERACTIVE_SINE_NICEGUI_STORAGE_SECRET=interactive-sine-secret-change-me

# ── LLM engine ───────────────────────────────────────────────────────────────

# llama.cpp / vLLM / OpenAI-compatible server, OR https://api.perplexity.ai
# for the Perplexity Agent API (routing is automatic).
INTERACTIVE_SINE_LLM_ENGINE_URL=http://localhost:8080

# API key ("not-needed" for local llama.cpp).
INTERACTIVE_SINE_LLM_API_KEY=not-needed

# Default model id for the settings dropdown.
INTERACTIVE_SINE_CHAT_DEFAULT_MODEL=local-model

# Default system prompt for the chat view.
INTERACTIVE_SINE_CHAT_DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# HTTP timeout (seconds) for streaming chat requests.
INTERACTIVE_SINE_HTTPX_TIMEOUT_CHAT=600

# ── Optional: additional engine endpoints ────────────────────────────────────

# Embedding server (used by apps that add RAG tool panels).
# INTERACTIVE_SINE_EMBEDDING_LLM_ENGINE_URL=http://localhost:8081

# Reranker server.
# INTERACTIVE_SINE_RERANKER_LLM_BASE_URL=http://localhost:8082

# ── Optional: shared framework knobs ────────────────────────────────────────

# Root directory for per-user log files (used by logs.py + the launcher).
# LOGS_PATH=./logs

# Worker thread limit for blocking log-file I/O (used by logs.py).
# CHAT_WORKER_THREADS=4
