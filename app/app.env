# app.env  –  Environment configuration for this app.
# Place this file in the same directory as app.py.
# Real shell / container environment variables always take precedence.

# ── Logging ────────────────────────────────────────────────────────────────────
# Directory where per-sandbox log files are written.
# Supports ~ expansion and absolute paths.
# Log files are named:  <APP_LOG_STEM>_<tenant_id>.log
LOGS_PATH=/tmp/log/apps_catalog/the_wave


# ── Add any other app-specific variables below ─────────────────────────────────
# Example:
# API_BASE_URL=http://localhost:8080
# MODEL_NAME=my-model
